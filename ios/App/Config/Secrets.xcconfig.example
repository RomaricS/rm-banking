// Copy to Secrets.xcconfig (same folder). This file is git-ignored.
// xcconfig treats "//" as a comment, so URLs need the $() trick below.

SLASH = /
SUPABASE_URL = https:$(SLASH)$(SLASH)YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-PUBLIC-KEY
AKWE_TEAM_ID = YOUR10CHARTEAMID
// Domain serving the apple-app-site-association file (Plaid OAuth redirect + goal invites)
AKWE_LINK_DOMAIN = akwe.app
