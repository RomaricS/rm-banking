# Copy to backend/supabase/functions/.env for `supabase functions serve`,
# and set the same values in production with: supabase secrets set --env-file ./functions/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.)

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                 # sandbox | production
# Required for OAuth banks (most European banks incl. La Banque Postale, some US/CA). Must also be
# registered in the Plaid dashboard and served as a universal link (see README).
PLAID_REDIRECT_URI=
# Optional: defaults to <SUPABASE_URL>/functions/v1/plaid-webhook
PLAID_WEBHOOK_URL=
# Sandbox only: skip webhook signature verification when testing with curl
PLAID_SKIP_WEBHOOK_VERIFY=0

# Apple Push Notifications (token-based). Leave empty to log pushes instead of sending.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.akwe.app
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Shared-goal invite links (universal link base). Defaults to akwe://join
INVITE_BASE_URL=https://akwe.app/join
